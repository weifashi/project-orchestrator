{
  "name": "project-orchestrator",
  "version": "0.1.48",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm build:plugins",
    "build:plugins": "node scripts/build-adapter-plugins.mjs",
    "check:generated": "node scripts/build-adapter-plugins.mjs --check",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "pretest": "pnpm -r build",
    "test": "vitest run --project unit --project web-unit",
    "pretest:integration": "pnpm -r build",
    "test:integration": "vitest run --project integration",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:plugins": "node scripts/validate-plugins.mjs",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "diff-check": "node scripts/web-diff-check.mjs",
    "release": "node scripts/build-release.mjs",
    "test:install": "bash tests/install/linux-smoke.sh && bash tests/install/release-layout.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
