{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "project-orchestrator/implementation-output"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "artifact_object_ids",
        "evidence_object_ids",
        "risks",
        "next_stage_notes",
        "deliverables"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifact_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "changed_file_manifest_object_id": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_stage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changed_file_manifest",
            "implementation_summary",
            "affected_business_rules"
          ],
          "properties": {
            "changed_file_manifest": {
              "type": "string",
              "minLength": 1
            },
            "implementation_summary": {
              "type": "string",
              "minLength": 1
            },
            "affected_business_rules": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
