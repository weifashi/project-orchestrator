[Unit]
Description=Local Project Orchestrator
After=project-orchestrator-operations.service
Requires=project-orchestrator-operations.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=@DATA_DIR@/runtime/service.env
ExecStartPre=/bin/sh -c 'i=0; while [ "$i" -lt 100 ]; do @PREFIX@/bin/project-orchestrator operations-ready >/dev/null 2>&1 && exit 0; i=$((i+1)); sleep 0.1; done; exit 1'
ExecStart=@PREFIX@/bin/project-orchestratord
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
